generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "mysql"
}

model user {
  id              Int               @id @default(autoincrement())
  nickname        String
  email           String            @unique
  password        String?
  picture         String?
  auth_token      String?
  point           Int               @default(0)
  type            String
  status          String            @default("active")
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  promo_usage_trx promo_usage_trx[]
  transactions    transaction[]
  user_role_trx   user_role_trx[]

  @@map("user")
}

model role {
  id            Int             @id @default(autoincrement())
  name          String          @unique @default("customer")
  description   String?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  user_role_trx user_role_trx[]
}

model user_role_trx {
  id         Int      @id @default(autoincrement())
  user_id    Int
  role_id    Int
  created_at DateTime @default(now())
  role       role     @relation(fields: [role_id], references: [id])
  user       user     @relation(fields: [user_id], references: [id])

  @@index([role_id], map: "user_role_trx_role_id_fkey")
  @@index([user_id], map: "user_role_trx_user_id_fkey")
}

model product {
  id                   Int                    @id @default(autoincrement())
  name                 String
  description          String?
  status               String
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  created_by           Int
  updated_by           Int?
  product_category_trx product_category_trx[]
  product_variants     product_variants[]
  promo_products_trx   promo_products_trx[]
  transaction_item     transaction_item[]
}

model product_variants {
  id                     Int                      @id @default(autoincrement())
  product_id             Int
  desc                   String?
  price                  Int
  status                 Boolean @default(false)
  stok                   Int
  size                   String?
  created_at             DateTime                 @default(now())
  created_by             Int
  product_variant_images product_variant_images[]
  product                product                  @relation(fields: [product_id], references: [id])
  transaction_item       transaction_item[]

  @@index([product_id], map: "product_variants_product_id_fkey")
}

model product_variant_images {
  id                 Int              @id @default(autoincrement())
  product_variant_id Int
  image              String
  created_at         DateTime         @default(now())
  created_by         Int
  product_variants   product_variants @relation(fields: [product_variant_id], references: [id])

  @@index([product_variant_id], map: "product_variant_images_product_variant_id_fkey")
}

model product_category {
  id                   Int                    @id @default(autoincrement())
  name                 String
  image                String?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  created_by           Int
  updated_by           Int?
  product_category_trx product_category_trx[]
}

model product_category_trx {
  id               Int              @id @default(autoincrement())
  product_id       Int
  category_id      Int
  created_at       DateTime         @default(now())
  created_by       Int
  product_category product_category @relation(fields: [category_id], references: [id])
  product          product          @relation(fields: [product_id], references: [id])

  @@index([category_id], map: "product_category_trx_category_id_fkey")
  @@index([product_id], map: "product_category_trx_product_id_fkey")
}

model promo {
  id                 Int                  @id @default(autoincrement())
  code_promo         String               @unique
  type               String
  value              Int
  title              String
  desc               String?
  min_order          Int?
  max_usage          Int?
  usage_per_user     Int?
  image              String?
  start_date         DateTime
  end_date           DateTime
  status             String
  all_product        Boolean              @default(false)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  created_by         Int
  updated_by         Int?
  promo_products_trx promo_products_trx[]
  promo_usage_trx    promo_usage_trx[]
}

model promo_products_trx {
  id         Int     @id @default(autoincrement())
  promo_id   Int
  product_id Int
  product    product @relation(fields: [product_id], references: [id])
  promo      promo   @relation(fields: [promo_id], references: [id])

  @@index([product_id], map: "promo_products_trx_product_id_fkey")
  @@index([promo_id], map: "promo_products_trx_promo_id_fkey")
}

model promo_usage_trx {
  id         Int      @id @default(autoincrement())
  promo_id   Int
  user_id    Int
  created_at DateTime @default(now())
  created_by Int
  promo      promo    @relation(fields: [promo_id], references: [id])
  user       user     @relation(fields: [user_id], references: [id])

  @@index([promo_id], map: "promo_usage_trx_promo_id_fkey")
  @@index([user_id], map: "promo_usage_trx_user_id_fkey")
}

model discount {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  type        String
  value       Int
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  created_by  Int
  updated_by  Int?
}

model transaction {
  id               Int                @id @default(autoincrement())
  user_id          Int
  total            Int
  status           String
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  user             user               @relation(fields: [user_id], references: [id])
  transaction_item transaction_item[]

  @@index([user_id], map: "transaction_user_id_fkey")
}

model transaction_item {
  id               Int              @id @default(autoincrement())
  transaction_id   Int
  product_id       Int
  variant_id       Int
  qty              Int
  price            Int
  product          product          @relation(fields: [product_id], references: [id])
  transaction      transaction      @relation(fields: [transaction_id], references: [id])
  product_variants product_variants @relation(fields: [variant_id], references: [id])

  @@index([product_id], map: "transaction_item_product_id_fkey")
  @@index([transaction_id], map: "transaction_item_transaction_id_fkey")
  @@index([variant_id], map: "transaction_item_variant_id_fkey")
}

model table {
  id         Int     @id @default(autoincrement())
  no_table   String
  desc       String?
  barcode    String?
  created_by Int
  updated_by Int?
}

model setting {
  id          Int     @id @default(autoincrement())
  name        String
  value       String
  description String?
}
