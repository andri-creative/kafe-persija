  generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
  }

  datasource db {
    provider = "mysql"
  }

  model User {
    id           Int             @id @default(autoincrement())
    nickname     String
    email        String          @unique
    picture      String?
    auth_token   String?
    point        Int             @default(0)
    type         String?
    status       String
    created_at   DateTime        @default(now())
    updated_at   DateTime        @updatedAt
    promoUsage   PromoUsageTrx[]
    transactions Transaction[]
    roles        UserRoleTrx[]
  }

  model Role {
    id          Int           @id @default(autoincrement())
    name        String        @unique
    description String?
    created_at  DateTime      @default(now())
    updated_at  DateTime      @updatedAt
    users       UserRoleTrx[]
  }

  model UserRoleTrx {
    id         Int      @id @default(autoincrement())
    user_id    Int
    role_id    Int
    created_at DateTime @default(now())
    created_by Int?
    role       Role     @relation(fields: [role_id], references: [id])
    user       User     @relation(fields: [user_id], references: [id])

    @@unique([user_id, role_id])
    @@index([role_id], map: "UserRoleTrx_role_id_fkey")
  }

  model Product {
    id               Int                  @id @default(autoincrement())
    name             String
    description      String?
    status           String
    created_at       DateTime             @default(now())
    updated_at       DateTime             @updatedAt
    created_by       Int?
    updated_by       Int?
    categories       ProductCategoryTrx[]
    variants         ProductVariant[]
    promos           PromoProductTrx[]
    transactionItems TransactionItem[]
  }

  model ProductVariant {
    id               Int                   @id @default(autoincrement())
    product_id       Int
    desc             String?
    price            Decimal
    created_at       DateTime              @default(now())
    created_by       Int?
    product          Product               @relation(fields: [product_id], references: [id])
    images           ProductVariantImage[]
    transactionItems TransactionItem[]

    @@index([product_id], map: "ProductVariant_product_id_fkey")
  }

  model ProductVariantImage {
    id                 Int            @id @default(autoincrement())
    product_variant_id Int
    image              String
    created_at         DateTime       @default(now())
    created_by         Int?
    variant            ProductVariant @relation(fields: [product_variant_id], references: [id])

    @@index([product_variant_id], map: "ProductVariantImage_product_variant_id_fkey")
  }

  model ProductCategory {
    id         Int                  @id @default(autoincrement())
    name       String
    image      String?
    created_at DateTime             @default(now())
    updated_at DateTime             @updatedAt
    created_by Int?
    updated_by Int?
    products   ProductCategoryTrx[]
  }

  model ProductCategoryTrx {
    id          Int             @id @default(autoincrement())
    product_id  Int
    category_id Int
    created_at  DateTime        @default(now())
    created_by  Int?
    category    ProductCategory @relation(fields: [category_id], references: [id])
    product     Product         @relation(fields: [product_id], references: [id])

    @@unique([product_id, category_id])
    @@index([category_id], map: "ProductCategoryTrx_category_id_fkey")
  }

  model Promo {
    id             Int               @id @default(autoincrement())
    code_promo     String            @unique
    type           String
    value          Decimal
    title          String
    desc           String?
    min_order      Decimal?
    max_usage      Int?
    usage_per_user Int?
    image          String?
    start_date     DateTime
    end_date       DateTime
    status         String
    all_product    Boolean           @default(false)
    created_at     DateTime          @default(now())
    updated_at     DateTime          @updatedAt
    created_by     Int?
    updated_by     Int?
    products       PromoProductTrx[]
    usage          PromoUsageTrx[]
  }

  model PromoProductTrx {
    id         Int     @id @default(autoincrement())
    promo_id   Int
    product_id Int
    product    Product @relation(fields: [product_id], references: [id])
    promo      Promo   @relation(fields: [promo_id], references: [id])

    @@unique([promo_id, product_id])
    @@index([product_id], map: "PromoProductTrx_product_id_fkey")
  }

  model PromoUsageTrx {
    id         Int      @id @default(autoincrement())
    promo_id   Int
    user_id    Int
    created_at DateTime @default(now())
    created_by Int?
    promo      Promo    @relation(fields: [promo_id], references: [id])
    user       User     @relation(fields: [user_id], references: [id])

    @@index([promo_id], map: "PromoUsageTrx_promo_id_fkey")
    @@index([user_id], map: "PromoUsageTrx_user_id_fkey")
  }

  model Discount {
    id          Int      @id @default(autoincrement())
    name        String
    description String?
    type        String
    value       Decimal
    is_active   Boolean  @default(true)
    created_at  DateTime @default(now())
    updated_at  DateTime @updatedAt
    created_by  Int?
    updated_by  Int?
  }

  model Table {
    id         Int      @id @default(autoincrement())
    no_table   String
    desc       String?
    barcode    String?
    created_at DateTime @default(now())
    updated_by Int?
  }

  model Setting {
    id          Int     @id @default(autoincrement())
    name        String  @unique
    value       String
    description String?
  }

  model Transaction {
    id         Int               @id @default(autoincrement())
    user_id    Int
    total      Decimal
    status     String
    created_at DateTime          @default(now())
    updated_at DateTime          @updatedAt
    user       User              @relation(fields: [user_id], references: [id])
    items      TransactionItem[]

    @@index([user_id], map: "Transaction_user_id_fkey")
  }

  model TransactionItem {
    id             Int            @id @default(autoincrement())
    transaction_id Int
    product_id     Int
    variant_id     Int
    qty            Int
    price          Decimal
    product        Product        @relation(fields: [product_id], references: [id])
    transaction    Transaction    @relation(fields: [transaction_id], references: [id])
    variant        ProductVariant @relation(fields: [variant_id], references: [id])

    @@index([product_id], map: "TransactionItem_product_id_fkey")
    @@index([transaction_id], map: "TransactionItem_transaction_id_fkey")
    @@index([variant_id], map: "TransactionItem_variant_id_fkey")
  }
